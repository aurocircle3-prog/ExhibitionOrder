# Server
PORT=3000
JWT_SECRET=change-me-in-production
APP_URL=http://localhost:3000

# Logging: error | warn | info | debug (defaults to debug locally, info in production)
LOG_LEVEL=

# MongoDB (leave blank to use local db/db.json for dev)
MONGO_URI=

# Cloudflare R2 (leave any blank to fall back to local disk storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Optional OCR for visiting-card autofill (Google Cloud Vision API key).
# Leave blank to skip OCR — staff will type firm/contact name manually.
OCR_API_KEY=

# Optional order-notification emails (Brevo HTTP API — not SMTP).
# Leave BREVO_API_KEY blank to skip emails entirely; nothing else about
# order creation depends on this being set.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=orders@expoorders.com
BREVO_SENDER_NAME=Expo Orders

# Auto-provisions (or updates) the platform admin account on server boot —
# for free Render tiers, which don't include Shell access to run
# db/seed-platform-admin.js directly. Set both, redeploy once, then you
# can safely leave them set (redeploys just re-sync the same account) or
# remove them after the account exists. Leave both blank to skip.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=
